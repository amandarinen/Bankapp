@page "/NewTransaction"
@inject IAccountService AccountService

<h3 class="mb-3">Transaction</h3>
@if (_accounts.Count <2)
{
    <p>Create at least two accounts to make a transaction.</p>
}
else
{
    <!--Transfer form-->
 <EditForm Model="_model" OnValidSubmit="OnSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger mb-3" />

        <!--From account-->
        <div class="mb-3">
            <label class="form-label">Transfer from</label>
            <InputSelect TValue="Guid"
                         @bind-Value="_model.FromAccountId" 
                         class="form-select"
                         @onchange="HandleFormChanged">
                <option value="@Guid.Empty">Choose Account</option>
                @foreach (var account in _accounts)
                {
                    <option value="@account.Id">@account.Name (@account.Balance.ToString("N2") @account.Currency)</option>
                }
            </InputSelect>
        </div>

        <!--To account-->
        <div class="mb-3">
            <label class="form-label">Transfer to</label>
            <InputSelect TValue="Guid"
                        @bind-Value="_model.ToAccountId" 
                        class="form-select"
                        disabled="@(_model.FromAccountId == Guid.Empty)">
                <option value="@Guid.Empty">Choose Account</option>
                @foreach (var account in _toAccounts.Where(x => x.Id != _model.FromAccountId))
                {
                    <option value="@account.Id">@account.Name (@account.Balance.ToString("N2") @account.Currency)</option>
                }
            </InputSelect>
        </div>

        <!--Amount-->
        <div class="mb-3">
            <label class="form-label">Amount</label>
            <InputNumber TValue="decimal" @bind-Value="_model.Amount" class="form-control" min="0.01" step="0.01" />
        </div>

        <!--Submit button-->
        <div class="mb-3">
        <button type="submit" class="btn btn-primary ">Complete Transaction</button>
        </div>
    </EditForm>

    <!-- List of all accounts -->
    <div>
        <h3 class="mb-3">All Accounts</h3>

        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Account Name</th>
                    <th>Type</th>
                    <th>Balance</th>
                    <th>Currency</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr>
                        <td>@account.Name</td>
                        <td>@account.AccountType</td>
                        <td>@account.Balance.ToString("N2")</td>
                        <td>@account.Currency</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3 class="mt-4 mb-3">Withdraw & Deposit</h3>
@if (_accounts.Count <1)
{
    <p>Skapa minst ett konto för att göra en transaktion</p>
}
else
{
    <!-- Withdraw -->
    <div class="row">
    <div class="col-md-6">
    <div class="card shadow-sm p-4 mb-4" style="max-width: 400px;">
        <h5 class="mb-3">Withdraw</h5>

            <EditForm Model="_withdrawModel" OnValidSubmit="OnWithdrawAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">Withdraw from</label>
                <InputSelect TValue="Guid"
                             @bind-Value="_withdrawModel.FromAccountId"
                             class="form-select"
                             @onchange="HandleFormChanged">
                    <option value="@Guid.Empty">Choose Account</option>
                    @foreach (var account in _accounts)
                    {
                                <option value="@account.Id">@account.Name (@account.Balance.ToString("N2") @account.Currency)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Amount</label>
                <InputNumber TValue="decimal" @bind-Value="_withdrawModel.Amount" class="form-control" min="0.01" step="0.01" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Complete Withdrawal</button>
        </EditForm>
    </div>
    </div>
    
     <!-- Deposit -->
    <div class="col-md-6">
    <div class="card shadow-sm p-4 mb-4" style="max-width: 400px;">
        <h5 class="mb-3">Deposit</h5>

        <EditForm Model="_depositModel" OnValidSubmit="OnDepositAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">Deposit to</label>
                <InputSelect TValue="Guid"
                             @bind-Value="_depositModel.ToAccountId"
                             class="form-select"
                             @onchange="HandleFormChanged">
                    <option value="@Guid.Empty">Choose Account</option>
                    @foreach (var account in _accounts)
                    {
                                <option value="@account.Id">@account.Name (@account.Balance.ToString("N2") @account.Currency)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Amount</label>
                <InputNumber TValue="decimal" @bind-Value="_depositModel.Amount" class="form-control" min="0.01" step="0.01" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Complete Deposit</button>
        </EditForm>
    </div>
    </div>
    </div>
}

<!-- Code -->
@code 
{
    // Instance variables
    private readonly TransferFormModel _model = new();
    private List<BankAccount> _accounts = new();
    private List<BankAccount> _toAccounts = new();
    private readonly WithdrawModel _withdrawModel = new();
    private readonly DepositModel _depositModel = new();

    /// <summary>
    /// Model for the data required to transfer between two accounts
    /// </summary>
    private class TransferFormModel
    {
        public Guid FromAccountId { get; set; }
        public Guid ToAccountId { get; set; }
        public decimal Amount { get; set; }
    }

    /// <summary>
    /// Model for the withdrawal transaction
    /// </summary>
    private class WithdrawModel
    {
        public Guid FromAccountId { get; set; }
        public decimal Amount { get; set; }
    }

    /// <summary>
    /// Model for the deposit transaction
    /// </summary>
    private class DepositModel
    {
        public Guid ToAccountId { get; set; }
        public decimal Amount { get; set; }
    }

    /// <summary>
    /// Loads all accounts when the page initializes and prepares accounts
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await AccountService.EnsureLoadedAsync();
        _accounts = AccountService.GetAccounts();
        _toAccounts = _accounts;
    }

    /// <summary>
    /// Executes when the user submits the transfer form.
    /// Validates input and performs a transfer between accounts.
    /// </summary>
    private async Task OnSubmitAsync()
    {
        if (_model.FromAccountId == Guid.Empty || _model.ToAccountId == Guid.Empty)
        {
            StateHasChanged();
        }

        if (_model.FromAccountId == _model.ToAccountId)
        {
            StateHasChanged();
        }
        try
        {
            await AccountService.Transfer(_model.FromAccountId, _model.ToAccountId, _model.Amount);

            //update list
            _accounts = AccountService.GetAccounts();

            //show validation
            var from = _accounts.First(x => x.Id == _model.FromAccountId);
            var to = _accounts.First(x => x.Id == _model.ToAccountId);

            _model.Amount = 0;
            StateHasChanged();
        }
        catch (Exception exception)
        {
            Console.WriteLine(exception.Message);
        }
    }

    /// <summary>
    /// Handles changes in account selection and updates available target accounts.
    /// </summary>
    private void HandleFormChanged(ChangeEventArgs eventArgs)
    {
        if (Guid.TryParse(eventArgs.Value?.ToString(), out var id))
        {
            OnFormChanged(id);
        }
    }

    /// <summary>
    /// Updates the available to account list based on the selected from account 
    /// </summary>
    private void OnFormChanged(Guid fromId)
    {
        _model.FromAccountId = fromId;
        var from = _accounts.FirstOrDefault(x => x.Id == fromId);

        if (from != null)
        {
            _toAccounts = _accounts.Where(account => account.Id != fromId).ToList();
        }
        else
        {
            _toAccounts = _accounts.ToList();
        }
        _model.ToAccountId = Guid.Empty;
    }

    /// <summary>
    /// Executes when the user submits the withdrawal form.
    /// Withdraws money from the selected account.
    /// </summary>
    private async Task OnWithdrawAsync()
    {
        try
        {
            await AccountService.WithdrawAsync(_withdrawModel.FromAccountId, _withdrawModel.Amount);
            _accounts = AccountService.GetAccounts();
            _withdrawModel.Amount = 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    /// <summary>
    /// Executes when the user submits the deposit form.
    /// Deposits money into the selected account.
    /// </summary>
    private async Task OnDepositAsync()
    {
        try
        {
            await AccountService.DepositAsync(_depositModel.ToAccountId, _depositModel.Amount);
            _accounts = AccountService.GetAccounts();
            _depositModel.Amount = 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

}


