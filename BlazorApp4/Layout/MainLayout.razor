@inherits LayoutComponentBase
@inject IAccountService AccountService
@inject LockService LockService

<!-- Main application layout -->
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Lock screen overlay (visible when app is locked) -->
@if (LockService.IsLocked)
{
    <div class="lock-overlay">
        <div class="lock-screen text-center">
            <h3>Enter PIN to unlock</h3>
            <input type="password" @bind="enteredPin" maxlength="4"
                   class="form-control w-25 mx-auto text-center" />
            <button class="btn btn-primary mt-3" @onclick="Unlock">Unlock</button>

            @if (!string.IsNullOrEmpty(message))
            {
                <p class="text-danger mt-2">@message</p>
            }
        </div>
    </div>
}

@code {
    // Holds the entered PIN code
    private string enteredPin = "";

    // Error message shown when the PIN is incorrect
    private string? message;

    /// <summary>
    /// Subscribes to the lock state change event when the layout initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        LockService.OnLockStateChanged += StateHasChanged;
    }

    /// <summary>
    /// Unsubscribes from the event when the layout is disposed.
    /// </summary>
    public void Dispose()
    {
        LockService.OnLockStateChanged -= StateHasChanged;
    }

    /// <summary>
    /// Attempts to unlock the app using the entered PIN.
    /// Shows an error message if the PIN is incorrect.
    /// </summary>
    private void Unlock()
    {
        message = null;
        LockService.Unlock(enteredPin);

        if (LockService.IsLocked)
        {
            message = "Incorrect PIN!";
            enteredPin = "";
        }
        else
        {
            enteredPin = "";
        }
    }
}
