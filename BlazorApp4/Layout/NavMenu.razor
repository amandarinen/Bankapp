@inject LockService LockService

<!-- Top navigation bar -->
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorApp4</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<!-- Side navigation menu -->
<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Home link -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Accounts page -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="CreateAccount">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Accounts
            </NavLink>
        </div>

        <!-- Transaction page -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="NewTransaction">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transaction
            </NavLink>
        </div>

        <!-- Transaction history page -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="TransactionHistory">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transaction History
            </NavLink>
        </div>

        <!-- Logout / lock button -->
        <div class="nav-item px-3">
            <a href="#" class="nav-link logout-link d-flex align-items-center gap-2 py-1" @onclick="LockApp">
                <span class="bi bi-lock fs-5 py-0" style="line-height: 1;"> </span>
                <span>Log out</span>
            </a>
        </div>


    </nav>
</div>

<!-- Code -->
@code {

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    /// <summary>
    /// Toggles the navigation menu visibility.
    /// </summary>
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    /// <summary>
    /// Locks the application when the user logs out.
    /// </summary>
    private void LockApp()
    {
        LockService.Lock();
    }
}